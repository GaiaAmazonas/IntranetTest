{
  "ConnectionStrings": {
    "Gaia": "Host=localhost;Port=5432;Database=gaia;Username=gaia;Password=CONFIGURE_LOCALLY"
  },
  "MicrosoftEntra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Dataverse": {
    "EnvironmentUrl": "https://YOUR_ENVIRONMENT.crm.dynamics.com",
    "WebApiEndpoint": "https://YOUR_ENVIRONMENT.api.crm.dynamics.com/api/data/v9.2",
    "Scope": "https://YOUR_ENVIRONMENT.crm.dynamics.com/user_impersonation"
  },
  "Authorization": {
    "BootstrapAdministrators": [
      "admin@example.org"
    ],
    "BootstrapAdministratorDocuments": []
  },
  "WebApplication": {
    "BaseUrl": "http://localhost:3000"
  },
  "FileStorage": {
    "SharePoint": {
      "Enabled": false,
      "ConfigurationSource": "Dataverse",
      "ConfigurationTable": "gaia_configuracionsharepoint",
      "RepositoryEnvironment": 2,
      "RealTestsEnabled": false,
      "RealTestsEnvironment": "Development",
      "MaximumFileBytes": 262144000,
      "SimpleUploadThresholdBytes": 4194304,
      "UploadChunkBytes": 3276800,
      "RequireContentScan": false,
      "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".docx", ".xlsx", ".pptx", ".mp4", ".webm", ".mov" ],
      "AllowedMimeTypes": [
        "application/pdf",
        "image/png",
        "image/jpeg",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "video/mp4",
        "video/webm",
        "video/quicktime"
      ]
    },
    "Credentials": {
      "YOUR_CREDENTIAL_ALIAS": {
        "TenantId": "YOUR_TENANT_ID",
        "ClientId": "YOUR_STORAGE_APP_CLIENT_ID",
        "AuthenticationMethod": "ClientSecret",
        "UseSystemAssignedManagedIdentity": false,
        "AllowedSiteIds": [ "YOUR_EXACT_SITE_ID" ],
        "AllowedTransferHosts": [ "YOUR_TENANT.sharepoint.com" ]
      }
    }
  }
}
