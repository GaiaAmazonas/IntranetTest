{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MicrosoftEntra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "CONFIGURE_LOCALLY",
    "ClientId": "CONFIGURE_LOCALLY",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "MicrosoftGraph": {
    "ProfilePhotoScope": "https://graph.microsoft.com/ProfilePhoto.Read.All"
  },
  "Dataverse": {
    "EnvironmentUrl": "https://YOUR_ENVIRONMENT.crm.dynamics.com",
    "WebApiEndpoint": "https://YOUR_ENVIRONMENT.api.crm.dynamics.com/api/data/v9.2",
    "Scope": "https://YOUR_ENVIRONMENT.crm.dynamics.com/user_impersonation"
  },
  "Authorization": {
    "BootstrapEnabled": false,
    "BootstrapAdministrators": [],
    "BootstrapAdministratorDocuments": []
  },
  "WebApplication": {
    "BaseUrl": "http://localhost:3000"
  },
  "DataProtection": {
    "KeysPath": "",
    "CertificateThumbprint": ""
  },
  "FileStorage": {
    "Development": {
      "Enabled": false
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
