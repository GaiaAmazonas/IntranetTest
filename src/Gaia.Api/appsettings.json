{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MicrosoftEntra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "CONFIGURE_LOCALLY",
    "ClientId": "CONFIGURE_LOCALLY",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "MicrosoftGraph": {
    "ProfilePhotoScope": "https://graph.microsoft.com/ProfilePhoto.Read.All"
  },
  "Dataverse": {
    "EnvironmentUrl": "https://YOUR_ENVIRONMENT.crm.dynamics.com",
    "WebApiEndpoint": "https://YOUR_ENVIRONMENT.api.crm.dynamics.com/api/data/v9.2",
    "Scope": "https://YOUR_ENVIRONMENT.crm.dynamics.com/user_impersonation"
  },
  "Authorization": {
    "BootstrapEnabled": false,
    "BootstrapAdministrators": [],
    "BootstrapAdministratorDocuments": []
  },
  "WebApplication": {
    "BaseUrl": "http://localhost:3000"
  },
  "DataProtection": {
    "KeysPath": "",
    "CertificateThumbprint": ""
  },
  "FileStorage": {
    "SharePoint": {
      "MaximumFileBytes": 262144000,
      "SimpleUploadThresholdBytes": 4194304,
      "UploadChunkBytes": 3276800,
      "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".docx", ".xlsx", ".pptx", ".mp4", ".webm", ".mov" ],
      "AllowedMimeTypes": [
        "application/pdf",
        "image/png",
        "image/jpeg",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "video/mp4",
        "video/webm",
        "video/quicktime"
      ]
    },
    "Development": {
      "Enabled": false
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
